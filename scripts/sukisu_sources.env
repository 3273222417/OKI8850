# Resolve the rolling manager-ci release at build time. The source checkout,
# Manager APK, and kernel version are paired to the same release target commit.
SUKISU_REPOSITORY=https://git.zako.shirkneko.top:20004/shirkneko/SukiSU.git
SUKISU_CI_API=https://git.zako.shirkneko.top:20004/api/v1/repos/shirkneko/SukiSU
SUKISU_CI_RELEASE_URL=https://git.zako.shirkneko.top:20004/shirkneko/SukiSU/releases/tag/manager-ci
SUKISU_CI_TAG=manager-ci
# Forgejo keeps the rolling release metadata, while APK assets are currently
# mirrored by CNB under this stable tag URL. The script still parses the
# current filename and version at build time; no version is pinned here.
SUKISU_CI_FALLBACK_RELEASE_URL=https://cnb.cool/shirkneko/sukisu-result/-/releases/tag/manager-ci
SUKISU_CI_MAX_ATTEMPTS=20
SUKISU_CI_RETRY_SECONDS=30
# The CI Manager is built from main; builtin is the separate SUSFS source.
SUKISU_VERSION_BASE=30000
SUKISU_VERSION_OFFSET=996
SUKISU_SUSFS_REPOSITORY=https://github.com/cctv18/susfs4oki.git
SUKISU_SUSFS_BRANCH=oki-android16-6.12
SUSFS_MODULE_REPOSITORY=sidex15/susfs4ksu-module
SUSFS_MODULE_WORKFLOW=build.yml
# Resolve the newest successful SUSFS module artifact regardless of the
# upstream version branch. The workflow and release prefix remain stable,
# while the version is read from the downloaded module.prop at build time.
SUSFS_MODULE_BRANCH=
SUSFS_MODULE_ARTIFACT_PREFIX=release-
